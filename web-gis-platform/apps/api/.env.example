# ════════════════════════════════════════════════════════════════
#  .env.example — Mẫu biến môi trường cho API
#  Sao chép sang .env và điền giá trị thực
#  cp .env.example .env
# ════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
# Khi chạy local: @127.0.0.1:5432
# Khi chạy Docker: @db:5432
DATABASE_URL="postgresql://postgres:postgres@db:5432/webgis?schema=public"

# UUID of the official project granted after a successful Demo registration.
DEMO_PROJECT_ID=""

# ── Cloudflare R2 Storage ─────────────────────────────────────────
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_BUCKET_NAME="webgis-assets"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ── JWT Auth ──────────────────────────────────────────────────────
JWT_SECRET="your_super_secret_jwt_key_at_least_32_chars"
JWT_REFRESH_SECRET="your_refresh_secret_key"

# ── Google OAuth (tùy chọn) ───────────────────────────────────────
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# ── Python Build Tool ─────────────────────────────────────────────
# Để trống → tự động phát hiện Python (Windows/Linux)
# Khi dùng Docker: PYTHON_CMD=python3  (đã cài sẵn trong container)
# Khi dùng Windows custom path: PYTHON_CMD=C:\Python312\python.exe
PYTHON_CMD=

# ── App Config ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/webgis?schema=public"

# Cloudflare R2 Configuration (S3-compatible Object Storage)
R2_ACCESS_KEY_ID="your_cloudflare_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_cloudflare_r2_secret_access_key"
R2_ENDPOINT="https://<your_cloudflare_account_id>.r2.cloudflarestorage.com"
R2_BUCKET_NAME="webgis-assets"
R2_PUBLIC_URL="https://pub-<your_r2_public_subdomain>.r2.dev"
